{
  "name": "poetry-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "node tests/integration/e2e/d3-acceptance-api.mjs --spawn",
    "test:e2e": "node tests/e2e/d3-browser.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:contracts": "pnpm build && tsx scripts/generate-contracts.ts",
    "check:generated": "pnpm build && tsx scripts/generate-contracts.ts --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:generated",
    "dev:api": "pnpm --filter @poetry/api dev",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @poetry/web dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@poetry/contracts": "workspace:*",
    "@poetry/prosody": "workspace:*",
    "@types/node": "24.10.0",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "globals": "17.13.0"
  }
}
